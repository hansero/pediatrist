# Gerçek (staging / prod) Firebase projesi için şablon.
# Bu dosyayı `.env.local` olarak kopyalayıp gerçek değerleri yalnızca orada tutun.
# `.env.local` git'e GİRMEZ. Gerçek anahtarları asla bu dosyaya yazmayın.
# Yerel emülatör geliştirmesi için hiçbir şey kopyalamanız gerekmez: `.env.development` hazır.

# --- Firebase Web SDK (tarayıcı) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Yalnızca localhost'tan gerçek projeye bağlanırken; Firebase konsolunda App Check debug token olarak kayıtlı olmalı.
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=

# --- Uygulama davranışı ---
# Gerçek projede emülatör kullanılmaz.
NEXT_PUBLIC_USE_EMULATORS=false
# MFA (TOTP) zorunluluğu ortam değişkeni DEĞİLDİR: Firestore `config/security.requireMfa` (N8).
# Doküman yoksa zorunludur; gerçek projede oluşturmanız gerekmez.
# WebAuthn (yoklama cihazı, F4.2): RP ID ve izinli kökenler istemcide DEĞİL, functions parametrelerindedir
# (`WEBAUTHN_RP_ID`, `WEBAUTHN_ORIGINS`); deploy sırasında sorulur.

# KVKK aydınlatma metni: veri sorumlusu (kurumun resmi unvanı) ve başvuru adresi (e-posta veya KEP/posta).
# İkisi de boşsa kayıt formu başvuru almaz (aydınlatma yükümlülüğü yerine getirilemez).
NEXT_PUBLIC_KVKK_CONTROLLER_NAME=
NEXT_PUBLIC_KVKK_CONTACT=
