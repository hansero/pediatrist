# `next dev` bu dosyayı otomatik yükler. YALNIZCA yerel Firebase emülatörleri içindir
# ve hiçbir gizli değer içermez (proje kimliği `demo-` önekli; gerçek bir projeye bağlanamaz).
# Gerçek (staging) projeye karşı geliştirmek için değerleri `.env.development.local`
# dosyasında ezin; o dosya git'e girmez. Üretim derlemesi (`next build`) bu dosyayı yüklemez.

NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-pediatrist
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-pediatrist.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-pediatrist.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

NEXT_PUBLIC_WEBAUTHN_RP_ID=localhost
