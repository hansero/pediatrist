rules_version = '2';

// Pediatrist — Cloud Storage güvenlik kuralları (REVISION_PLAN F2.2)
//
// - Yetkinin kaynağı Firestore'daki `users/{uid}` dokümanıdır (D3); token claim'lerine bakılmaz.
//   Firestore ile aynı mantık: aktif üyelik + `auth_time > tokensValidAfter` + (zorunluysa) MFA
//   (`config/security`, N8; bkz. firestore.rules).
//   Çapraz servis erişimi (`firestore.get`) üretimde Storage servis hesabına IAM izni gerektirir;
//   deploy sırasında Firebase CLI bu izni ister (DEPLOY.md).
// - Sunumlar PDF olarak yüklenir (D19): tarayıcı pptx'i görüntüleyemez ve filigran uygulanamaz.
// - SVG kabul edilmez (içinde betik çalıştırılabilir).
// - Listelenmeyen her yol kapalıdır.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }

    function profile() {
      return firestore.get(profilePath()).data;
    }

    // Ortam güvenlik ayarı (N8, D20, D21): Firestore `config/security`; yoksa şartlar zorunlu (bkz. firestore.rules).
    function securityConfigPath() {
      return /databases/(default)/documents/config/security;
    }

    function securityConfigured(field) {
      return firestore.exists(securityConfigPath())
        && firestore.get(securityConfigPath()).data.get(field, true) == false;
    }

    // Zorunluluk kapalıysa (`false`) geçer; aksi halde şartı sağlamalı (D20, D21).
    function securitySatisfied() {
      return (securityConfigured('requireMfa')
          || request.auth.token.get('firebase', {}).get('sign_in_second_factor', null) != null)
        && (securityConfigured('requireEmailVerified')
          || request.auth.token.get('email_verified', false) == true);
    }

    function isActive() {
      return signedIn()
        && firestore.exists(profilePath())
        && profile().status == 'active'
        && request.auth.token.auth_time > profile().get('tokensValidAfter', 0)
        && securitySatisfied();
    }

    function isAdmin() {
      return isActive() && profile().role == 'admin';
    }

    function sizeBelowMb(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }

    function contentTypeMatches(pattern) {
      return request.resource.contentType.matches(pattern);
    }

    // Modül 1: eğitim materyalleri — materials/{materialId}/{dosya}
    match /materials/{materialId}/{fileName} {
      allow read: if isActive();
      allow create, update: if isAdmin()
        && sizeBelowMb(150)
        && (contentTypeMatches('application/pdf')
            || contentTypeMatches('video/(mp4|webm|quicktime)')
            || contentTypeMatches('image/(png|jpeg|webp)'));
      // Silmede `request.resource` yoktur; boyut/tür kontrolü yapılmaz (AUDIT C11).
      allow delete: if isAdmin();
    }

    // Modül 4: sınav görselleri — quiz_media/{dosya}
    match /quiz_media/{fileName} {
      allow read: if isActive();
      allow create, update: if isAdmin()
        && sizeBelowMb(15)
        && contentTypeMatches('image/(png|jpeg|webp|gif)');
      allow delete: if isAdmin();
    }
  }
}
