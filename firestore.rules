rules_version = '2';

// Pediatrist — Firestore güvenlik kuralları (REVISION_PLAN F2.1)
//
// İlkeler:
//  - Yetkinin TEK kaynağı `users/{uid}` dokümanıdır (D3). Custom claims yalnızca önbellektir;
//    askıya alınan / rolü düşürülen bir üyenin elindeki eski token kuralları geçemez (AUDIT C5).
//  - `tokensValidAfter` (epoch saniye) ile oturum iptali: bu andan önce açılmış oturumlar geçersizdir.
//    Aynı mantık Cloud Functions tarafında `functions/src/guards.ts` içindedir.
//  - İstemci hiçbir koleksiyona doğrudan yazamaz; bütün yazımlar Cloud Functions (Admin SDK) üzerindendir.
//    Tek istisna: kendi materyal okuma ilerlemesi.
//  - Listelenmeyen her yol varsayılan olarak kapalıdır.
service cloud.firestore {
  match /databases/{database}/documents {

    // ===================================================================================
    // Yardımcılar
    // ===================================================================================
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function profile() {
      return get(profilePath()).data;
    }

    // Oturum, profildeki iptal zamanından (tokensValidAfter) SONRA açılmış olmalı.
    function sessionNotRevoked() {
      return request.auth.token.auth_time > profile().get('tokensValidAfter', 0);
    }

    // Ortam güvenlik ayarı (N8, D20, D21): `config/security`. Doküman yoksa veya `requireMfa` açıkça false
    // değilse MFA ZORUNLU (güvenli varsayılan). Aynı doküman guards.ts ve istemci tarafından da okunur.
    function securityConfigPath() {
      return /databases/$(database)/documents/config/security;
    }

    function mfaRequired() {
      return !exists(securityConfigPath()) || get(securityConfigPath()).data.get('requireMfa', true) != false;
    }

    // Oturum ikinci faktörle (TOTP) açıldı mı?
    function hasSecondFactor() {
      return request.auth.token.get('firebase', {}).get('sign_in_second_factor', null) != null;
    }

    function mfaSatisfied() {
      return !mfaRequired() || hasSecondFactor();
    }

    // D21: e-posta doğrulama zorunluluğu da aynı dokümandan (yoksa zorunlu).
    function emailVerificationRequired() {
      return !exists(securityConfigPath())
        || get(securityConfigPath()).data.get('requireEmailVerified', true) != false;
    }

    function emailSatisfied() {
      return !emailVerificationRequired() || request.auth.token.get('email_verified', false) == true;
    }

    function securitySatisfied() {
      return mfaSatisfied() && emailSatisfied();
    }

    // Etkin üye: profil `active`, oturum iptal edilmemiş, (zorunluysa) ikinci faktörle açılmış ve e-postası doğrulanmış.
    // Not: kendi profilini okuma (`isSelf`) MFA istemez; oturum bağlamı ve MFA kurulum sayfası buna dayanır.
    function isActive() {
      return signedIn() && exists(profilePath()) && profile().status == 'active' && sessionNotRevoked()
        && securitySatisfied();
    }

    function isAdmin() {
      return isActive() && profile().role == 'admin';
    }

    // ===================================================================================
    // Üyeler
    // ===================================================================================
    match /users/{uid} {
      // Kendi profilini durumu ne olursa olsun okuyabilir (onay bekleme / askı ekranı için).
      allow read: if isSelf(uid) || isAdmin();

      // Profil SUNUCUDA oluşturulur (`completeRegistration`, D4); rol, durum, kıdem ve cihaz bağı yalnızca
      // Cloud Functions ile değişir. İstemci hiçbir koşulda profil yazamaz.
      allow create, update, delete: if false;
    }

    // Ortam güvenlik ayarları (N8, D20): oturum açmış herkes okur (istemci MFA kurulumuna yönlendirme için);
    // yalnızca Admin SDK / konsoldan yazılır.
    match /config/security {
      allow read: if signedIn();
      allow write: if false;
    }

    // Davet kodları: yalnızca admin görür (AUDIT C9). Oluşturma/kullanma Cloud Functions ile (F2.3).
    match /invitations/{inviteId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ===================================================================================
    // Modül 1: Eğitim materyalleri
    // ===================================================================================
    match /materials/{materialId} {
      // Taslak (yükleme bekleyen) yalnızca admin'e görünür; hekim listesi `status == 'published'` ile sorgular.
      allow read: if isAdmin() || (isActive() && resource.data.status == 'published');
      allow write: if false; // yalnızca callable'lar: createMaterial / finalizeMaterialUpload / updateMaterial / deleteMaterial

      // Kişisel okuma ilerlemesi: yalnızca sahibi, yalnızca tanımlı alanlarla yazar.
      match /progress/{uid} {
        allow read: if (isSelf(uid) && isActive()) || isAdmin();
        // Yalnızca yayındaki materyale (taslağa / silinmişe ilerleme yazılmaz, F6.1).
        allow create, update: if isSelf(uid) && isActive()
          && get(/databases/$(database)/documents/materials/$(materialId)).data.status == 'published'
          && request.resource.data.keys().hasOnly(['uid', 'secondsSpent', 'lastPage', 'completed', 'updatedAt'])
          && request.resource.data.keys().hasAll(['uid', 'secondsSpent', 'lastPage', 'completed', 'updatedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.secondsSpent is int
          && request.resource.data.secondsSpent >= 0
          && request.resource.data.secondsSpent <= 604800
          && request.resource.data.lastPage is int
          && request.resource.data.lastPage >= 0
          && request.resource.data.lastPage <= 10000
          && request.resource.data.completed is bool
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
    }

    // Not (F13.5): `{path=**}/progress` collectionGroup kuralı kaldırıldı. Okunma raporu materyal başına alt
    // koleksiyonu okur (yukarıdaki kural); joker eşleşme ileride eklenecek her `progress` koleksiyonunu da açardı.

    // ===================================================================================
    // Modül 2: Hesaplayıcı protokol notları
    // ===================================================================================
    match /calculators_config/{calcId} {
      allow read: if isActive();
      allow write: if false; // F7.4: callable (denetim kaydı ile)
    }

    // ===================================================================================
    // Modül 3: Ders katılım kontrolü
    // ===================================================================================
    match /attendance_sessions/{sessionId} {
      // Hekim yalnızca canlı dersi görür; geçmiş dersler admin'e özel.
      allow read: if isAdmin() || (isActive() && resource.data.status == 'live');
      allow write: if false;

      match /records/{uid} {
        allow read: if (isSelf(uid) && isActive()) || isAdmin();
        allow write: if false;
      }
    }

    // Ders ve katılımcı bazlı raporlar için düz katılım logu.
    match /attendance_logs/{logId} {
      allow read: if isAdmin() || (isActive() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // HMAC anahtarları istemciye tamamen kapalıdır (admin dahil).
    match /attendance_secrets/{sessionId} {
      allow read, write: if false;
    }

    // ===================================================================================
    // Modül 4: Online sınav
    // ===================================================================================
    match /quizzes/{quizId} {
      // Taslaklar yalnızca admin'e görünür; hekim yayındaki / kapanmış sınavın başlık bilgisini görür.
      allow read: if isAdmin() || (isActive() && resource.data.status in ['published', 'closed']);
      allow write: if false;

      // Sorular hekime DOĞRUDAN açılmaz (AUDIT C7): sınava başlamadan okunup süre sınırı atlatılabiliyordu.
      // Hekim soruları `startQuizAttempt` yanıtıyla alır (F5.1).
      match /questions_public/{questionId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // 8. (doğru seçenek) ve 9. (feedback) alanlar hekime her zaman kapalı.
    match /quiz_answer_keys/{quizId}/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /quiz_question_archive/{archiveId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Hekim yalnızca kendi girişimlerini okur (liste sorgusu `where uid == auth.uid` içermeli).
    // Girişimde yalnızca puan ve soru başına doğru/yanlış + kendi yanıtı vardır; doğru cevap ve feedback
    // girişime yazılmaz, `getAttemptReport` revealPolicy'ye (D7) göre döndürür (F5.1).
    match /quiz_attempts/{attemptId} {
      allow read: if isAdmin() || (isActive() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // Süre içinde kaydedilen yanıtlar: yalnızca callable'lar (startQuizAttempt / saveAttemptDraft / teslim).
    match /quiz_attempt_drafts/{attemptId} {
      allow read, write: if false;
    }

    // ===================================================================================
    // Değiştirilemez denetim kayıtları
    // ===================================================================================
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
