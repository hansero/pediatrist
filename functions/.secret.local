# YALNIZCA Firebase emülatörü için (functions emülatörü bu dosyadan "secret" değerlerini okur).
# Gerçek projede değer Secret Manager'dadır: `firebase functions:secrets:set AUDIT_IP_SALT`.
# Buradaki değer gizli DEĞİLDİR ve hiçbir gerçek ortamda kullanılmaz (F9.2).
AUDIT_IP_SALT=yalnizca-emulator-icin-tuz-0123456789
