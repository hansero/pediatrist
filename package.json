{
  "name": "pediatrist",
  "version": "1.0.0",
  "private": true,
  "description": "Pediatri Eğitim Kliniği Yönetim ve Eğitim Platformu (Firebase Zero-Trust Architecture)",
  "scripts": {
    "postinstall": "node scripts/copy-pdfjs-assets.mjs",
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && npm --prefix functions run typecheck",
    "check:no-mock": "node scripts/check-no-mock.mjs",
    "test": "npm run test:unit",
    "test:unit": "vitest run --project unit",
    "test:rules": "node scripts/firebase.mjs emulators:exec --only firestore,storage --project demo-pediatrist \"vitest run --project rules\"",
    "test:functions": "node scripts/firebase.mjs emulators:exec --only auth,firestore,storage --project demo-pediatrist \"vitest run --project functions\"",
    "test:e2e": "npm --prefix functions run build && node scripts/firebase.mjs emulators:exec --only auth,firestore,storage,functions --project demo-pediatrist \"npm run seed && playwright test\"",
    "emulators": "node scripts/firebase.mjs emulators:start --only auth,firestore,storage,functions --project demo-pediatrist",
    "seed": "tsx scripts/seed-emulator.ts",
    "deploy:rules": "node scripts/firebase.mjs deploy --only firestore:rules,firestore:indexes,storage",
    "deploy:functions": "node scripts/firebase.mjs deploy --only functions"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "firebase": "^11.10.0",
    "next": "^15.5.29",
    "pdfjs-dist": "^6.5.438",
    "qrcode": "1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/eslintrc": "^3.3.7",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.35.0",
    "jsdom": "^26.1.0",
    "playwright-core": "1.63.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "22"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "postcss": "^8.5.32"
  }
}
